---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import GameFilters from '../components/GameFilters.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <GameFilters categories={categories} publishers={publishers} />

          <p
            id="filter-results-count"
            data-testid="filter-results-count"
            aria-live="polite"
            class="mb-4 text-sm text-slate-400"
          >
            Showing <span id="filter-visible-count">{games.length}</span> of {games.length} games
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div
            hidden
            role="status"
            aria-live="polite"
            data-testid="no-filtered-results"
            class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700"
          >
            <p class="text-slate-300">No games match the selected filters.</p>
          </div>

          <script>
            const filterSection = document.querySelector<HTMLElement>('[data-testid="game-filters"]');
            const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
            const noResults = document.querySelector<HTMLElement>('[data-testid="no-filtered-results"]');
            const visibleCountEl = document.getElementById('filter-visible-count');
            const clearButton = document.getElementById('clear-filters');

            function selectedValues(filterType: string): string[] {
              const inputs = filterSection?.querySelectorAll<HTMLInputElement>(
                `input[data-filter-type="${filterType}"]:checked`,
              );
              return inputs ? Array.from(inputs).map((input) => input.value) : [];
            }

            function applyFilters(): void {
              const categoryIds = selectedValues('category');
              const publisherIds = selectedValues('publisher');
              let visibleCount = 0;

              for (const card of gameCards) {
                const matchesCategory =
                  categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
                const matchesPublisher =
                  publisherIds.length === 0 || publisherIds.includes(card.dataset.publisherId ?? '');
                const isVisible = matchesCategory && matchesPublisher;

                card.hidden = !isVisible;
                if (isVisible) visibleCount += 1;
              }

              if (visibleCountEl) visibleCountEl.textContent = String(visibleCount);
              if (noResults) noResults.hidden = visibleCount !== 0;
            }

            filterSection?.addEventListener('change', (event) => {
              if (event.target instanceof HTMLInputElement && event.target.dataset.filterType) {
                applyFilters();
              }
            });

            clearButton?.addEventListener('click', () => {
              filterSection?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => {
                input.checked = false;
              });
              applyFilters();
            });

            applyFilters();
          </script>
        </>
      )}
    </div>
  </div>
</Layout>

