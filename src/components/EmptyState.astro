---
// Presents a consistent empty-result message.
interface Props {
    text?: string;
}

const { text } = Astro.props;
---

<div
    data-testid="empty-state"
    class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700 light:bg-white light:border-slate-300 contrast:bg-black contrast:border-2 contrast:border-white"
>
    {text ? (
        <p data-testid="empty-state-text" class="text-slate-300 light:text-slate-700 contrast:text-white">{text}</p>
    ) : (
        <slot />
    )}
</div>
