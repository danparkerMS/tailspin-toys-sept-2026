---
// Renders the site navigation and browser-persisted display preference controls.
import Menu from '../assets/icons/menu.svg';
---

<header class="bg-blue-700 text-white p-4 shadow-md transition-colors duration-300 motion-reduce:transition-none light:bg-slate-100 light:text-slate-900 light:border-b light:border-slate-300 light:shadow-sm contrast:bg-black contrast:text-white contrast:border-b-2 contrast:border-yellow-300 contrast:shadow-none">
  <div class="container mx-auto flex justify-between items-center gap-2 pl-2 pr-2 sm:pl-4 sm:pr-4">
    <div class="flex min-w-0 items-center">
      <div class="relative group">
        <button id="menu-toggle" class="min-h-11 min-w-11 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-700 rounded mr-2 sm:mr-4 light:text-slate-900 light:focus:ring-blue-700 light:focus:ring-offset-slate-100 contrast:text-yellow-300 contrast:focus:ring-yellow-300 contrast:focus:ring-offset-black" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu" data-testid="menu-toggle">
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
        <nav id="menu" aria-label="Main" class="hidden absolute left-0 mt-2 w-48 bg-slate-800 text-white rounded shadow-lg z-10 transition-colors duration-300 motion-reduce:transition-none light:bg-white light:text-slate-900 light:border light:border-slate-300 contrast:bg-black contrast:text-white contrast:border-2 contrast:border-yellow-300">
          <ul class="py-1">
            <li><a href="/" class="block px-4 py-3 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500 light:hover:bg-slate-100 light:focus:ring-blue-700 contrast:text-yellow-300 contrast:hover:bg-yellow-300 contrast:hover:text-black contrast:focus:ring-yellow-300" data-testid="nav-home">Home</a></li>
            <li><a href="/about" class="block px-4 py-3 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500 light:hover:bg-slate-100 light:focus:ring-blue-700 contrast:text-yellow-300 contrast:hover:bg-yellow-300 contrast:hover:text-black contrast:focus:ring-yellow-300" data-testid="nav-about">About</a></li>
          </ul>
        </nav>
      </div>
      <div class="truncate text-lg sm:text-xl font-bold"><a href="/" class="hover:underline focus:outline-none focus:ring-2 focus:ring-white rounded light:text-blue-800 light:focus:ring-blue-700 contrast:text-yellow-300 contrast:focus:ring-yellow-300" data-testid="site-home-link">Tailspin Toys</a></div>
    </div>
    <fieldset class="flex shrink-0 items-center gap-2">
      <legend class="sr-only">Display preferences</legend>
      <button
        id="light-mode-toggle"
        type="button"
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-blue-200/60 bg-blue-800/60 p-2 text-sm font-semibold text-white transition-colors duration-200 motion-reduce:transition-none hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-700 sm:px-3 light:border-slate-500 light:bg-white light:text-slate-900 light:hover:bg-slate-200 light:focus:ring-blue-700 light:focus:ring-offset-slate-100 contrast:border-2 contrast:border-yellow-300 contrast:bg-black contrast:text-yellow-300 contrast:hover:bg-yellow-300 contrast:hover:text-black contrast:focus:ring-yellow-300 contrast:focus:ring-offset-black"
        aria-label="Light mode"
        aria-pressed="false"
        data-testid="light-mode-toggle"
      >
        <svg class="h-5 w-5 sm:mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
        <span class="hidden sm:inline">Light mode</span>
        <span id="light-mode-status" class="sr-only lg:not-sr-only lg:ml-1 lg:rounded lg:bg-white lg:px-1.5 lg:py-0.5 lg:text-xs lg:text-blue-900 light:lg:bg-slate-900 light:lg:text-white contrast:lg:border contrast:lg:border-current contrast:lg:bg-black contrast:lg:text-yellow-300">Off</span>
      </button>
      <button
        id="contrast-toggle"
        type="button"
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-blue-200/60 bg-blue-800/60 p-2 text-sm font-semibold text-white transition-colors duration-200 motion-reduce:transition-none hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-700 sm:px-3 light:border-slate-500 light:bg-white light:text-slate-900 light:hover:bg-slate-200 light:focus:ring-blue-700 light:focus:ring-offset-slate-100 contrast:border-2 contrast:border-yellow-300 contrast:bg-black contrast:text-yellow-300 contrast:hover:bg-yellow-300 contrast:hover:text-black contrast:focus:ring-yellow-300 contrast:focus:ring-offset-black"
        aria-label="High contrast"
        aria-pressed="false"
        data-testid="contrast-toggle"
      >
        <svg class="h-5 w-5 sm:mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"></path>
        </svg>
        <span class="hidden sm:inline">High contrast</span>
        <span id="contrast-status" class="sr-only lg:not-sr-only lg:ml-1 lg:rounded lg:bg-white lg:px-1.5 lg:py-0.5 lg:text-xs lg:text-blue-900 light:lg:bg-slate-900 light:lg:text-white contrast:lg:border contrast:lg:border-current contrast:lg:bg-black contrast:lg:text-yellow-300">Off</span>
      </button>
    </fieldset>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  const lightModeToggle = document.getElementById('light-mode-toggle');
  const lightModeStatus = document.getElementById('light-mode-status');
  const contrastToggle = document.getElementById('contrast-toggle');
  const contrastStatus = document.getElementById('contrast-status');
  const lightModeStorageKey = 'tailspin-light-mode';
  const contrastStorageKey = 'tailspin-high-contrast';
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    });
    
    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });
  }

  const savePreference = (key: string, enabled: boolean): void => {
    try {
      localStorage.setItem(key, String(enabled));
    } catch (error) {
      console.error(`Unable to save the ${key} preference.`, error);
    }
  };

  if (lightModeToggle && lightModeStatus) {
    const setLightMode = (enabled: boolean): void => {
      document.documentElement.classList.toggle('light-mode', enabled);
      lightModeToggle.setAttribute('aria-pressed', String(enabled));
      lightModeStatus.textContent = enabled ? 'On' : 'Off';
    };

    setLightMode(document.documentElement.classList.contains('light-mode'));

    lightModeToggle.addEventListener('click', () => {
      const enabled = !document.documentElement.classList.contains('light-mode');
      setLightMode(enabled);
      savePreference(lightModeStorageKey, enabled);
    });

    window.addEventListener('storage', (event) => {
      if (event.key === lightModeStorageKey && event.newValue !== null) {
        setLightMode(event.newValue === 'true');
      }
    });
  }

  if (contrastToggle && contrastStatus) {
    const setHighContrast = (enabled: boolean): void => {
      document.documentElement.classList.toggle('high-contrast', enabled);
      contrastToggle.setAttribute('aria-pressed', String(enabled));
      contrastStatus.textContent = enabled ? 'On' : 'Off';
    };

    setHighContrast(document.documentElement.classList.contains('high-contrast'));

    contrastToggle.addEventListener('click', () => {
      const enabled = !document.documentElement.classList.contains('high-contrast');
      setHighContrast(enabled);
      savePreference(contrastStorageKey, enabled);
    });

    window.addEventListener('storage', (event) => {
      if (event.key === contrastStorageKey && event.newValue !== null) {
        setHighContrast(event.newValue === 'true');
      }
    });
  }
</script>